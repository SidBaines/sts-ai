+std::string describeGameState(const GameContext &gc) {
+    std::ostringstream os;
+    os << "Act " << gc.act
+       << ", floor " << gc.floorNum
+       << ", screen " << screenStateName(gc.screenState)
+       << ", room " << roomLabel(gc.curRoom)
+       << ", end-of-act boss " << monsterEncounterStrings[static_cast<int>(gc.boss)]
+       << "\nYour HP: " << gc.curHp << "/" << gc.maxHp
+       << ", gold: " << gc.gold
+       << "\nDeck: " << gc.deck
+       << "\nRelics: " << gc.relics
+       << "\nPotions: ";
+
+    if (gc.potionCount == 0) {
+        os << "none";
+    } else {
+        for (int i = 0; i < gc.potionCount; ++i) {
+            if (i > 0) {
+                os << ", ";
+            }
+            os << safePotionName(gc.potions[i]);
+        }
+    }
+
+    // The MAP_SCREEN map is intentionally NOT dumped here. The old ASCII grid
+    // (gc.map->toString) was not reliably parseable by LLM agents; the map is now
+    // exposed structurally via GameContext::map_graph() and rendered as a neutral
+    // per-choice textual summary in Python (sts_ai.glossary._render_map). See
+    // docs/map_representation_handoff.md.
+    if (gc.screenState == ScreenState::REWARDS) {
+        os << "\nRewards: " << gc.info.rewardsContainer.toString();
+    } else if (gc.screenState == ScreenState::CARD_SELECT) {
+        os << "\n" << cardSelectPurpose(gc.info.selectScreenType)
+           << " (chosen " << gc.info.haveSelectedCards.size() << " of " << gc.info.toSelectCount << ").";
+    }
+
+    return os.str();
+}
+
+// Enumerate the legal in-combat actions for the current input state. Reuses the
+// battle searcher's own enumeration so the action list shown to the agent exactly
+// matches what the engine accepts (mirrors GameAction::getAllActionsInState for
+// out-of-combat). The searcher only enumerates the PLAYER_NORMAL and CARD_SELECT
+// input states; every other state is engine-internal (the random/shuffle states
+// are resolved inside executeActions and never surface as a decision). The
+// searcher constructor copies bc once and runs no search, so this is cheap and
+// has no side effect on the passed BattleContext.
+std::vector<search::Action> enumerateBattleActions(
+        const BattleContext &bc, bool includeCardType) {
+    // Fail closed (loudly) if the battle is awaiting a player choice that the
+    // enumerator does not handle (e.g. CHOOSE_STANCE_ACTION, SCRY, CHOOSE_*_CARDS,
+    // GAMBLE). Such states are reachable only via specific cards/potions that are
+    // out of milestone-1 scope. Without this, the empty action list would surface
+    // as a silent `no_legal_actions` rollout stop mid-combat; instead raise a clear
+    // simulator_error naming the state so the gap is visible rather than abandoned.
+    if (bc.outcome == Outcome::UNDECIDED
+            && bc.inputState != InputState::EXECUTING_ACTIONS
+            && bc.inputState != InputState::PLAYER_NORMAL
+            && bc.inputState != InputState::CARD_SELECT) {
+        throw std::runtime_error(
+            std::string("unhandled combat input state (no Python action enumeration available): inputState=")
+            + std::to_string(static_cast<int>(bc.inputState)));
+    }
+
+    search::BattleScumSearcher2 searcher(bc);
+    search::BattleScumSearcher2::Node node;
+    searcher.enumerateActionsForNode(node, bc);
+
+    std::vector<search::Action> actions;
+    actions.reserve(node.edges.size());
+    for (const auto &edge : node.edges) {
+        actions.push_back(edge.action);
+    }
+    // Secret Technique/Weapon address cards by raw draw-pile index. Exposing that
+    // native enumeration order leaks the otherwise-hidden draw order through the
+    // menu. Sort the raw actions by their public card descriptions while retaining
+    // each action's original bits, so execution semantics are unchanged. Duplicate
+    // copies are subsequently collapsed by the Python display layer.
+    if (bc.inputState == InputState::CARD_SELECT
+            && (bc.cardSelectInfo.cardSelectTask == CardSelectTask::SECRET_TECHNIQUE
+                || bc.cardSelectInfo.cardSelectTask == CardSelectTask::SECRET_WEAPON)) {
+        std::stable_sort(actions.begin(), actions.end(), [&](const auto &lhs, const auto &rhs) {
+            return describeCardSelectChoice(bc, lhs, includeCardType)
+                < describeCardSelectChoice(bc, rhs, includeCardType);
+        });
+    }
+    return actions;
+}
+
+// Name the card a SINGLE_CARD_SELECT action refers to, resolving the source pile
+// from the active card-select task. Mirrors Action::enumerateCardSelectActions /
+// executeSingleCardSelectActionHelper, where the select index is the raw pile
+// index. Upstream printDesc only shows "TASK (idx)", which is not judgeable.
+std::string describeCardSelectChoice(
+        const BattleContext &bc, const search::Action &a, bool includeCardType) {
+    const auto task = bc.cardSelectInfo.cardSelectTask;
+    const int idx = a.getSelectIdx();
+    std::ostringstream os;
+    os << "select card for " << cardSelectTaskStrings[static_cast<int>(task)];
+
+    const CardInstance *card = nullptr;
+    switch (task) {
+        case CardSelectTask::CODEX:
+            if (idx == 3) {
+                os << ": skip";
+                return os.str();
+            }
+            if (idx >= 0 && idx < static_cast<int>(bc.cardSelectInfo.cards.size())) {
+                const CardInstance choice(bc.cardSelectInfo.cards[idx]);
+                os << ": " << (includeCardType
+                    ? publicCardLabel(choice, true) : publicCardName(choice));
+                return os.str();
+            }
+            break;
+        case CardSelectTask::DISCOVERY:
+            if (idx >= 0 && idx < static_cast<int>(bc.cardSelectInfo.cards.size())) {
+                const CardInstance choice(bc.cardSelectInfo.cards[idx]);
+                os << ": " << (includeCardType
+                    ? publicCardLabel(choice, true) : publicCardName(choice));
+                return os.str();
+            }
+            break;
+        case CardSelectTask::ARMAMENTS:
+        case CardSelectTask::DUAL_WIELD:
+        case CardSelectTask::EXHAUST_ONE:
+        case CardSelectTask::FORETHOUGHT:
+        case CardSelectTask::WARCRY:
+            if (idx >= 0 && idx < bc.cards.cardsInHand) {
+                card = &bc.cards.hand[idx];
+            }
+            break;
+        case CardSelectTask::HEADBUTT:
+        case CardSelectTask::HOLOGRAM:
+        case CardSelectTask::LIQUID_MEMORIES_POTION:
+            if (idx >= 0 && idx < static_cast<int>(bc.cards.discardPile.size())) {
+                card = &bc.cards.discardPile[idx];
+            }
+            break;
+        case CardSelectTask::SECRET_TECHNIQUE:
+        case CardSelectTask::SECRET_WEAPON:
+            if (idx >= 0 && idx < static_cast<int>(bc.cards.drawPile.size())) {
+                card = &bc.cards.drawPile[idx];
+            }
+            break;
+        case CardSelectTask::EXHUME:
+            if (idx >= 0 && idx < static_cast<int>(bc.cards.exhaustPile.size())) {
+                card = &bc.cards.exhaustPile[idx];
+            }
+            break;
+        default:
+            // Multi-select and currently unsupported tasks are not pile-indexed;
+            // fall back to the option index below.
+            break;
+    }
+
+    if (card != nullptr) {
+        os << ": " << (includeCardType
+            ? publicCardLabel(*card, true) : publicCardName(*card));
+    } else {
+        os << " (option " << idx << ")";
+    }
+    return os.str();
+}
+
+// Keep same-name living enemies distinct in card/potion targets and damage
+// lists, so Python's display de-dup preserves each legal target. Public parsers
+// tolerate the " [enemy i]" suffix.
+void appendEnemyLabel(std::ostream &os, const BattleContext &bc, int idx) {
+    const std::string name = bc.monsters.arr[idx].getName();
+    os << name;
+    int sameNameAlive = 0;
+    for (int mi = 0; mi < bc.monsters.monsterCount; ++mi) {
+        if (bc.monsters.arr[mi].isAlive()
+                && std::string(bc.monsters.arr[mi].getName()) == name) {
+            ++sameNameAlive;
+        }
+    }
+    if (sameNameAlive > 1) {
+        os << " [enemy " << idx << "]";
+    }
+}
+
+// Sim-computed attack damage (target-correct, pre-block, multi-hit aware).
+// Existing targeted, table-based annotations remain unconditional for byte
+// compatibility. The opt-in additionally covers supported special formulas,
+// Fiend Fire and untargeted attacks, including Whirlwind (the only X-cost attack
+// implemented by useAttackCard). Sword Boomerang's random hits show per-hit
+// damage for each possible target, not a total for each enemy. Values describe
+// current public modifiers, before Block and card-play triggers that may change
+// them or Fiend Fire's hand size; they do not predict reactive hit effects.
+// Scalar format: "(deal total = per xN)" (or "(deal total)"). Whirlwind and
+// Fiend Fire always print "= per xN", including x0 and x1.
+// Multiple targets: "(deal per target: name: total; name: total = per xN)".
+// Random targets: "(deal per random hit, N hits total: name: per; name: per)".
+// Names may carry " [enemy i]" to disambiguate living enemies with the same name.
+// The nonnumeric prefixes prevent scalar _DEAL_RE consumers in lightspeed.py,
+// combat_public_v4.py and glossary.py, and _ACTION_ATTACK_RE in
+// tests/integration/test_combat_public_v3.py, from reading a per-target value as
+// the whole attack's damage.
+void appendComputedDamage(
+        std::ostream &os, const BattleContext &bc, const CardInstance &card,
+        int base, int dealTarget, const std::vector<int> &dealTargets) {
+    const int hits = getHitCount(bc, card);
+    const bool dynamicHits = card.getId() == CardId::WHIRLWIND
+        || card.getId() == CardId::FIEND_FIRE;
+    const bool randomTargets = card.getId() == CardId::SWORD_BOOMERANG
+        && dealTargets.size() > 1;
+    const auto appendDamage = [&](int target) {
+        const int per = bc.calculateCardDamage(card, target, base);
+        if (!randomTargets && (hits > 1 || dynamicHits)) {
+            os << (per * hits) << " = " << per << " x" << hits;
+        } else {
+            os << per;
+        }
+    };
+    if (dealTargets.size() > 1) {
+        if (randomTargets) {
+            os << " (deal per random hit, " << hits << " hits total: ";
+        } else {
+            os << " (deal per target: ";
+        }
+        for (std::size_t i = 0; i < dealTargets.size(); ++i) {
+            if (i > 0) os << "; ";
+            const int target = dealTargets[i];
+            appendEnemyLabel(os, bc, target);
+            os << ": ";
+            appendDamage(target);
+        }
+    } else {
+        os << " (deal ";
+        appendDamage(dealTarget);
+    }
+    os << ")";
+}
+
+// Human-/model-facing description of a single combat action. Mirrors the campfire
+// enrichment principle: spell out card/potion/target names rather than bare
+// indices. Card-select actions delegate to the engine's printDesc.
+std::string describeBattleAction(
+        const BattleContext &bc, const search::Action &a, bool includeCardType,
+        bool includeComputedDamage) {
+    std::ostringstream os;
+    switch (a.getActionType()) {
+        case search::ActionType::CARD: {
+            const auto &c = bc.cards.hand[a.getSourceIdx()];
+            os << "play " << publicCardName(c);
+            if (includeCardType) {
+                os << publicCardTypeTag(c);
+            }
+            os << publicCardCostLabel(c);
+            int dealTarget = -1;
+            if (c.requiresTarget()) {
+                const int target = a.getTargetIdx();
+                if (target >= 0 && target < bc.monsters.monsterCount) {
+                    os << " -> ";
+                    appendEnemyLabel(os, bc, target);
+                    dealTarget = target;
+                }
+            }
+            int base = -1;
+            std::vector<int> dealTargets;
+            if (c.getType() == CardType::ATTACK && (!c.isXCost()
+                    || (includeComputedDamage && c.getId() == CardId::WHIRLWIND))) {
+                if (dealTarget >= 0) {
+                    // v2's unconditional static-table annotations for Ritual Dagger
+                    // and Mind Blast are known pre-existing defects preserved for
+                    // flag-off byte stability. v3 overrides them only under the opt-in.
+                    if (includeComputedDamage && c.getId() == CardId::RITUAL_DAGGER) {
+                        base = c.specialData;
+                    } else if (includeComputedDamage && c.getId() == CardId::MIND_BLAST) {
+                        base = static_cast<int>(bc.cards.drawPile.size());
+                    } else if (!hasSpecialDamageFormula(c.getId())) {
+                        base = getBaseDamage(c.getId(), c.isUpgraded());
+                    } else if (includeComputedDamage) {
+                        base = getSpecialDamageBase(bc, c);
+                    }
+                } else if (includeComputedDamage && !c.requiresTarget()) {
+                    for (int mi = 0; mi < bc.monsters.monsterCount; ++mi) {
+                        if (!bc.monsters.arr[mi].isDeadOrEscaped()) {
+                            dealTargets.push_back(mi);
+                        }
+                    }
+                    if (dealTargets.size() == 1) {
+                        dealTarget = dealTargets.front();
+                    }
+                    base = getUntargetedDamageBase(c);
+                }
+            }
+            if (base >= 0 && (dealTarget >= 0 || !dealTargets.empty())) {
+                appendComputedDamage(os, bc, c, base, dealTarget, dealTargets);
+            }
+            break;
+        }
+        case search::ActionType::POTION: {
+            const auto p = bc.potions[a.getSourceIdx()];
+            const int target = a.getTargetIdx();
+            // execute() treats target > 5 as a discard: the enumerator packs idx2 = -1
+            // (which decodes to 8191, not -1) for the discard / no-valid-target case.
+            // Checking `== -1` here would mislabel discards as drinks and, for a
+            // targeted potion, index monsters.arr out of bounds.
+            if (target > 5) {
+                os << "discard potion " << safePotionName(p);
+            } else {
+                os << "drink potion " << safePotionName(p);
+                if (potionRequiresTarget(p) && target >= 0 && target < bc.monsters.monsterCount) {
+                    os << " -> ";
+                    appendEnemyLabel(os, bc, target);
+                }
+            }
+            break;
+        }
+        case search::ActionType::END_TURN:
+            os << "end turn";
+            break;
+        case search::ActionType::SINGLE_CARD_SELECT:
+            os << describeCardSelectChoice(bc, a, includeCardType);
+            break;
+        case search::ActionType::MULTI_CARD_SELECT:
+        default:
+            a.printDesc(os, bc);
+            break;
+    }
+    return os.str();
+}
+
+// Human-/model-facing serialization of the combat state (mirrors describeGameState).
+std::string describeBattleState(
+        const BattleContext &bc, bool publicState=false, bool includeCardType=false) {
+    std::ostringstream os;
+    os << "Battle turn " << bc.turn
+       << "\nPlayer HP: " << bc.player.curHp << "/" << bc.player.maxHp
+       << ", block: " << bc.player.block
+       << ", energy: " << bc.player.energy << "/" << static_cast<int>(bc.player.energyPerTurn);
+
+    if (publicState) {
+        os << "\nTurn counters: cards played " << bc.player.cardsPlayedThisTurn
+           << ", attacks " << bc.player.attacksPlayedThisTurn
+           << ", skills " << bc.player.skillsPlayedThisTurn
+           << ", discarded " << bc.player.cardsDiscardedThisTurn
+           << "\nStance: " << publicStanceName(bc.player.stance)
+           << "\nPlayer resources: draw per turn "
+           << static_cast<int>(bc.player.cardDrawPerTurn)
+           << ", orb slots " << static_cast<int>(bc.player.orbSlots);
+    }
+
+    os << "\nPlayer powers: ";
+    {
+        bool any = false;
+        auto emit = [&](const char *name, int amount) {
+            if (amount == 0) {
+                return;
+            }
+            if (any) {
+                os << ", ";
+            }
+            os << name << " " << amount;
+            any = true;
+        };
+        if (publicState) {
+            for (const auto &entry : publicPlayerPowerEntries(bc.player)) {
+                emit(entry.first.c_str(), entry.second);
+            }
+        } else {
+            // Preserve the legacy serializer byte-for-byte for COMP-002.
+            emit("Strength", bc.player.strength);
+            emit("Dexterity", bc.player.dexterity);
+            emit("Focus", bc.player.focus);
+            emit("Artifact", bc.player.artifact);
+            for (const auto &pair : bc.player.statusMap) {
+                if (pair.first == PlayerStatus::STRENGTH
+                        || pair.first == PlayerStatus::DEXTERITY
+                        || pair.first == PlayerStatus::FOCUS
+                        || pair.first == PlayerStatus::ARTIFACT) {
+                    continue;
+                }
+                if (any) {
+                    os << ", ";
+                }
+                os << playerStatusStrings[static_cast<int>(pair.first)]
+                   << " " << pair.second;
+                any = true;
+            }
+        }
+        if (!any) {
+            os << "none";
+        }
+    }
+
+    os << "\nEnemies:";
+    for (int i = 0; i < bc.monsters.monsterCount; ++i) {
+        const auto &m = bc.monsters.arr[i];
+        if (!m.isAlive()) {
+            continue;
+        }
+        os << "\n  [" << i << "] " << m.getName()
+           << " HP " << m.curHp << "/" << m.maxHp
+           << ", block " << m.block
+           << ", intent " << monsterMoveStrings[static_cast<int>(m.moveHistory[0])];
+        // Sim-computed incoming damage (pre-block, after strength/vulnerable/weak).
+        // Gated on isAttacking(); getMoveBaseDamage has a {0,0} default so this is
+        // safe for every move. Multi-hit shows "total = per x hits".
+        if (m.isAttacking()) {
+            const auto di = m.getMoveBaseDamage(bc);
+            const int per = m.calculateDamageToPlayer(bc, di.damage);
+            os << " (deal ";
+            if (di.attackCount > 1) {
+                os << (per * di.attackCount) << " = " << per << " x" << di.attackCount;
+            } else {
+                os << per;
+            }
+            os << ")";
+        }
+        // Non-zero enemy statuses the player cares about (negatives shown too).
+        {
+            auto emitES = [&](const char *nm, int amt) { if (amt != 0) os << ", " << nm << " " << amt; };
+            emitES("Strength", m.strength);
+            emitES("Vulnerable", m.vulnerable);
+            emitES("Weak", m.weak);
+            emitES("Poison", static_cast<int>(m.poison));
+        }
+        // Persistent enemy powers the player must plan around (Enrage, Metallicize,
+        // Curl Up, Mode Shift, Asleep, ...). Without these, an effect like Nob's
+        // Enrage was invisible after its opening turn, so the strength growth had no
+        // visible cause. Read via the printLogs-style status accessors; each has a
+        // KEY entry in sts_ai.glossary. Strength/Vulnerable/Weak/Poison are emitted
+        // above, so they are excluded here to avoid duplicates.
+        for (const auto s : kPlayerRelevantEnemyPowers) {
+            if (m.hasStatusInternal(s)) {
+                os << ", " << enemyStatusStrings[static_cast<int>(s)]
+                   << " " << m.getStatusInternal(s);
+            }
+        }
+    }
+
+    os << "\nHand:";
+    if (bc.cards.cardsInHand == 0) {
+        os << " empty";
+    } else {
+        for (int i = 0; i < bc.cards.cardsInHand; ++i) {
+            const auto &c = bc.cards.hand[i];
+            os << "\n  [" << i << "] " << publicCardName(c);
+            if (includeCardType) {
+                os << publicCardTypeTag(c);
+            }
+            os << publicCardCostLabel(c);
+        }
+    }
+
+    os << "\nPiles: draw " << bc.cards.drawPile.size()
+       << ", discard " << bc.cards.discardPile.size()
+       << ", exhaust " << bc.cards.exhaustPile.size();
+
+    if (publicState) {
+        appendPublicPile(os, "Draw pile", aggregatePublicCards(
+            bc.cards.drawPile.begin(), bc.cards.drawPile.end(), includeCardType));
+        appendPublicPile(os, "Discard pile", aggregatePublicCards(
+            bc.cards.discardPile.begin(), bc.cards.discardPile.end(), includeCardType));
+        appendPublicPile(os, "Exhaust pile", aggregatePublicCards(
+            bc.cards.exhaustPile.begin(), bc.cards.exhaustPile.end(), includeCardType));
+        appendPublicRelics(os, bc);
+    }
+
+    if (publicState) {
+        os << "\nPotions (capacity " << bc.potionCapacity << "): ";
+        if (bc.potionCapacity == 0) {
+            os << "none";
+        }
+        for (int i = 0; i < bc.potionCapacity; ++i) {
+            if (i > 0) {
+                os << ", ";
+            }
+            os << "[" << i << "] ";
+            const auto potion = bc.potions[i];
+            if (potion == Potion::EMPTY_POTION_SLOT) {
+                os << "empty";
+            } else {
+                os << safePotionName(potion);
+            }
+        }
+    } else {
+        os << "\nPotions: ";
+        bool any = false;
+        for (int i = 0; i < bc.potionCapacity; ++i) {
+            const auto p = bc.potions[i];
+            if (p == Potion::EMPTY_POTION_SLOT) {
+                continue;
+            }
+            if (any) {
+                os << ", ";
+            }
+            os << safePotionName(p);
+            any = true;
+        }
+        if (!any) {
+            os << "none";
+        }
+    }
+
+    if (bc.inputState == InputState::CARD_SELECT) {
+        os << "\n(card select in progress)";
+        if (publicState) {
+            os << "\nSelection type: "
+               << cardSelectTaskStrings[static_cast<int>(bc.cardSelectInfo.cardSelectTask)]
+               << "\nSelection candidates:";
+            const auto actions = enumerateBattleActions(bc, includeCardType);
+            if (actions.empty()) {
+                os << " none";
+            } else {
+                for (const auto &action : actions) {
+                    os << "\n  - " << describeBattleAction(bc, action, includeCardType);
+                }
+            }
+        }
+    }
+
+    return os.str();
+}
+
+pybind11::dict searchBestBattleAction(
+    const BattleContext &bc,
+    std::int64_t simulations,
+    const pybind11::object &searchSeed,
+    const pybind11::object &drawOrderSeed,
+    bool includeCardType
+) {
+    if (simulations < 1) {
+        throw std::invalid_argument("search_best_action simulations must be >= 1");
+    }
+    if (bc.outcome != Outcome::UNDECIDED) {
+        throw std::invalid_argument("search_best_action requires an undecided battle");
+    }
+    if (bc.inputState != InputState::PLAYER_NORMAL && bc.inputState != InputState::CARD_SELECT) {
+        throw std::invalid_argument("search_best_action requires a player decision state");
+    }
+    // Secret Technique/Weapon actions encode a raw draw-pile index. Shuffling a
+    // teacher clone would make the same bits name a different card in the live
+    // public menu, so an intervention label could silently attach to the wrong
+    // action. Count this hidden-order query as an abstention in Python instead of
+    // manufacturing false identity across the two states.
+    if (!drawOrderSeed.is_none()
+            && bc.inputState == InputState::CARD_SELECT
+            && (bc.cardSelectInfo.cardSelectTask == CardSelectTask::SECRET_TECHNIQUE
+                || bc.cardSelectInfo.cardSelectTask == CardSelectTask::SECRET_WEAPON)) {
+        throw std::invalid_argument(
+            "draw_order_seed is unsupported for draw-index card selection");
+    }
+
+    // Teacher-only hidden-state intervention for measuring whether a label is
+    // stable across public-equivalent draw orders.  It operates on a clone, uses a
+    // separate RNG, and neither the permutation nor the real order is ever rendered
+    // by the public observation APIs.
+    BattleContext teacherState(bc);
+    const bool drawOrderPerturbed = !drawOrderSeed.is_none();
+    std::uint64_t effectiveDrawOrderSeed = 0;
+    if (drawOrderPerturbed) {
+        effectiveDrawOrderSeed = drawOrderSeed.cast<std::uint64_t>();
+        // Public piles are unordered. Canonicalize before fixed-seed sampling,
+        // so the finite sampled worlds cannot depend on the true hidden order.
+        // The key uses only the card fields surfaced in public_cards; unique IDs
+        // and latent specialData (except the public upgrade count) are excluded.
+        auto publicCardLess = [](const CardInstance &a, const CardInstance &b) {
+            auto key = [](const CardInstance &c) {
+                return std::make_tuple(static_cast<int>(c.id), c.getUpgradeCount(),
+                    c.cost, c.costForTurn, c.freeToPlayOnce, c.retain);
+            };
+            return key(a) < key(b);
+        };
+        std::sort(teacherState.cards.drawPile.begin(), teacherState.cards.drawPile.end(), publicCardLess);
+        std::sort(teacherState.cards.discardPile.begin(), teacherState.cards.discardPile.end(), publicCardLess);
+        std::sort(teacherState.cards.exhaustPile.begin(), teacherState.cards.exhaustPile.end(), publicCardLess);
+        std::mt19937_64 drawOrderRng(effectiveDrawOrderSeed);
+        std::shuffle(
+            teacherState.cards.drawPile.begin(),
+            teacherState.cards.drawPile.end(),
+            drawOrderRng);
+    }
+
+    // Canonical discard/exhaust order changes selection indices. Map the
+    // selected instance back to the const live state before exposing any root
+    // action. Instance identity is routing metadata, never a policy feature.
+    auto mapRootAction = [&](const search::Action &action) -> search::Action {
+        if (!drawOrderPerturbed || bc.inputState != InputState::CARD_SELECT
+                || action.getActionType() != search::ActionType::SINGLE_CARD_SELECT) {
+            return action;
+        }
+        auto mapIndex = [&](const auto &from, const auto &to) -> search::Action {
+            const int idx = action.getSelectIdx();
+            if (idx < 0 || idx >= static_cast<int>(from.size())) {
+                throw std::runtime_error("invalid sampled pile selection index");
+            }
+            const auto &card = from[idx];
+            for (int i = 0; i < static_cast<int>(to.size()); ++i) {
+                const auto &live = to[i];
+                if (std::tie(card.id, card.uniqueId, card.specialData, card.cost,
+                            card.costForTurn, card.upgraded, card.freeToPlayOnce, card.retain)
+                        == std::tie(live.id, live.uniqueId, live.specialData, live.cost,
+                            live.costForTurn, live.upgraded, live.freeToPlayOnce, live.retain)) {
+                    return search::Action(search::ActionType::SINGLE_CARD_SELECT, i);
+                }
+            }
+            throw std::runtime_error("sampled selection instance missing from live pile");
+        };
+        switch (bc.cardSelectInfo.cardSelectTask) {
+            case CardSelectTask::EXHUME:
+                return mapIndex(teacherState.cards.exhaustPile, bc.cards.exhaustPile);
+            case CardSelectTask::HEADBUTT:
+            case CardSelectTask::HOLOGRAM:
+            case CardSelectTask::LIQUID_MEMORIES_POTION:
+            case CardSelectTask::MEDITATE:
+                return mapIndex(teacherState.cards.discardPile, bc.cards.discardPile);
+            default:
+                return action;
+        }
+    };
+
+    // BattleScumSearcher2 takes another deep BattleContext copy.  Re-seeding
+    // changes only the searcher's private action-selection RNG; it cannot touch
+    // the battle RNGs or any field of the const live context passed here.
+    search::BattleScumSearcher2 searcher(teacherState);
+    const std::uint64_t effectiveSearchSeed = searchSeed.is_none()
+        ? bc.seed + static_cast<std::uint64_t>(bc.floorNum)
+        : searchSeed.cast<std::uint64_t>();
+    searcher.randGen.seed(effectiveSearchSeed);
+    searcher.search(simulations);
+
+    const bool hasWinningSequence = searcher.outcomePlayerHp > 0
+        && !searcher.bestActionSequence.empty();
+    const search::Action *selected = nullptr;
+    const char *selectionMethod = nullptr;
+    if (hasWinningSequence && mapRootAction(searcher.bestActionSequence.front()).isValidAction(bc)) {
+        selected = &searcher.bestActionSequence.front();
+        selectionMethod = "winning_sequence";
+    } else {
+        std::int64_t maxVisits = -1;
+        for (const auto &edge : searcher.root.edges) {
+            if (mapRootAction(edge.action).isValidAction(bc) && edge.node.simulationCount > maxVisits) {
+                selected = &edge.action;
+                maxVisits = edge.node.simulationCount;
+            }
+        }
+        selectionMethod = "most_visited_root";
+    }
+    if (selected == nullptr) {
+        throw std::runtime_error("search_best_action found no selectable legal root edge");
+    }
+
+    pybind11::dict result;
+    const auto liveSelected = mapRootAction(*selected);
+    result["action"] = liveSelected;
+    result["bits"] = liveSelected.bits;
+    result["description"] = describeBattleAction(bc, liveSelected, includeCardType);
+    result["selection_method"] = selectionMethod;
+    result["simulations_requested"] = simulations;
+    result["root_simulations"] = searcher.root.simulationCount;
+    result["best_evaluation"] = searcher.bestActionValue;
+    result["min_evaluation"] = searcher.minActionValue;
+    result["predicted_player_hp"] = searcher.outcomePlayerHp;
+    result["winning_sequence_found"] = hasWinningSequence;
+
+    pybind11::list rootEdges;
+    for (const auto &edge : searcher.root.edges) {
+        pybind11::dict d;
+        const auto liveEdge = mapRootAction(edge.action);
+        d["action"] = liveEdge;
+        d["bits"] = liveEdge.bits;
+        d["description"] = describeBattleAction(bc, liveEdge, includeCardType);
+        d["valid"] = liveEdge.isValidAction(bc);
+        d["visits"] = edge.node.simulationCount;
+        d["evaluation_sum"] = edge.node.evaluationSum;
+        d["mean_evaluation"] = edge.node.simulationCount == 0
+            ? 0.0 : edge.node.evaluationSum / edge.node.simulationCount;
+        rootEdges.append(d);
+    }
+    result["root_edges"] = rootEdges;
+
+    // Descriptions must be resolved against the state at each sequence step: hand
+    // indices are not stable after a play.  This operates on another private copy.
+    pybind11::list sequence;
+    BattleContext sequenceState(*searcher.rootState);
+    for (const auto &action : searcher.bestActionSequence) {
+        if (!action.isValidAction(sequenceState)) {
+            break;
+        }
+        pybind11::dict d;
+        d["action"] = action;
+        d["bits"] = action.bits;
+        d["description"] = describeBattleAction(sequenceState, action, includeCardType);
+        d["turn"] = sequenceState.turn;
+        sequence.append(d);
+        action.execute(sequenceState);
+    }
+    result["best_sequence"] = sequence;
+
+    pybind11::dict provenance;
+    provenance["searcher"] = "BattleScumSearcher2";
+    provenance["evaluation"] = "BattleScumSearcher2::evaluateEndState";
+    provenance["search_seed"] = effectiveSearchSeed;
+    provenance["draw_order_perturbed"] = drawOrderPerturbed;
+    provenance["hidden_pile_order_canonicalized"] = drawOrderPerturbed;
+    if (drawOrderPerturbed) {
+        provenance["draw_order_seed"] = effectiveDrawOrderSeed;
+    } else {
+        provenance["draw_order_seed"] = pybind11::none();
+    }
+    provenance["state_copied"] = true;
+    provenance["live_state_mutated"] = false;
+    provenance["teacher_uses_full_simulator_state"] = true;
+    provenance["student_safe_observation"] = false;
+    provenance["floor"] = bc.floorNum;
+    provenance["turn"] = bc.turn;
+    provenance["encounter"] = std::string(
+        monsterEncounterStrings[static_cast<int>(bc.encounter)]);
+    provenance["exploration_parameter"] = searcher.explorationParameter;
+    result["provenance"] = provenance;
+    return result;
+}
