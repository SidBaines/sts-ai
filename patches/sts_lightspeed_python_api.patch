+pybind11::dict searchBestBattleAction(
+    const BattleContext &bc,
+    std::int64_t simulations,
+    const pybind11::object &searchSeed,
+    const pybind11::object &drawOrderSeed,
+    bool includeCardType
+) {
+    if (simulations < 1) {
+        throw std::invalid_argument("search_best_action simulations must be >= 1");
+    }
+    if (bc.outcome != Outcome::UNDECIDED) {
+        throw std::invalid_argument("search_best_action requires an undecided battle");
+    }
+    if (bc.inputState != InputState::PLAYER_NORMAL && bc.inputState != InputState::CARD_SELECT) {
+        throw std::invalid_argument("search_best_action requires a player decision state");
+    }
+    // Secret Technique/Weapon actions encode a raw draw-pile index. Shuffling a
+    // teacher clone would make the same bits name a different card in the live
+    // public menu, so an intervention label could silently attach to the wrong
+    // action. Count this hidden-order query as an abstention in Python instead of
+    // manufacturing false identity across the two states.
+    if (!drawOrderSeed.is_none()
+            && bc.inputState == InputState::CARD_SELECT
+            && (bc.cardSelectInfo.cardSelectTask == CardSelectTask::SECRET_TECHNIQUE
+                || bc.cardSelectInfo.cardSelectTask == CardSelectTask::SECRET_WEAPON)) {
+        throw std::invalid_argument(
+            "draw_order_seed is unsupported for draw-index card selection");
+    }
+
+    // Teacher-only hidden-state intervention for measuring whether a label is
+    // stable across public-equivalent draw orders.  It operates on a clone, uses a
+    // separate RNG, and neither the permutation nor the real order is ever rendered
+    // by the public observation APIs.
+    BattleContext teacherState(bc);
+    const bool drawOrderPerturbed = !drawOrderSeed.is_none();
+    std::uint64_t effectiveDrawOrderSeed = 0;
+    if (drawOrderPerturbed) {
+        effectiveDrawOrderSeed = drawOrderSeed.cast<std::uint64_t>();
+        std::mt19937_64 drawOrderRng(effectiveDrawOrderSeed);
+        std::shuffle(
+            teacherState.cards.drawPile.begin(),
+            teacherState.cards.drawPile.end(),
+            drawOrderRng);
+    }
+
+    // BattleScumSearcher2 takes another deep BattleContext copy.  Re-seeding
+    // changes only the searcher's private action-selection RNG; it cannot touch
+    // the battle RNGs or any field of the const live context passed here.
+    search::BattleScumSearcher2 searcher(teacherState);
+    const std::uint64_t effectiveSearchSeed = searchSeed.is_none()
+        ? bc.seed + static_cast<std::uint64_t>(bc.floorNum)
+        : searchSeed.cast<std::uint64_t>();
+    searcher.randGen.seed(effectiveSearchSeed);
+    searcher.search(simulations);
+
+    const bool hasWinningSequence = searcher.outcomePlayerHp > 0
+        && !searcher.bestActionSequence.empty();
+    const search::Action *selected = nullptr;
+    const char *selectionMethod = nullptr;
+    if (hasWinningSequence && searcher.bestActionSequence.front().isValidAction(bc)) {
+        selected = &searcher.bestActionSequence.front();
+        selectionMethod = "winning_sequence";
+    } else {
+        std::int64_t maxVisits = -1;
+        for (const auto &edge : searcher.root.edges) {
+            if (edge.action.isValidAction(bc) && edge.node.simulationCount > maxVisits) {
+                selected = &edge.action;
+                maxVisits = edge.node.simulationCount;
+            }
+        }
+        selectionMethod = "most_visited_root";
+    }
+    if (selected == nullptr) {
+        throw std::runtime_error("search_best_action found no selectable legal root edge");
+    }
+
+    pybind11::dict result;
+    result["action"] = *selected;
+    result["bits"] = selected->bits;
+    result["description"] = describeBattleAction(bc, *selected, includeCardType);
+    result["selection_method"] = selectionMethod;
+    result["simulations_requested"] = simulations;
+    result["root_simulations"] = searcher.root.simulationCount;
+    result["best_evaluation"] = searcher.bestActionValue;
+    result["min_evaluation"] = searcher.minActionValue;
+    result["predicted_player_hp"] = searcher.outcomePlayerHp;
+    result["winning_sequence_found"] = hasWinningSequence;
+
+    pybind11::list rootEdges;
+    for (const auto &edge : searcher.root.edges) {
+        pybind11::dict d;
+        d["action"] = edge.action;
+        d["bits"] = edge.action.bits;
+        d["description"] = describeBattleAction(bc, edge.action, includeCardType);
+        d["valid"] = edge.action.isValidAction(bc);
+        d["visits"] = edge.node.simulationCount;
+        d["evaluation_sum"] = edge.node.evaluationSum;
+        d["mean_evaluation"] = edge.node.simulationCount == 0
+            ? 0.0 : edge.node.evaluationSum / edge.node.simulationCount;
+        rootEdges.append(d);
+    }
+    result["root_edges"] = rootEdges;
+
+    // Descriptions must be resolved against the state at each sequence step: hand
+    // indices are not stable after a play.  This operates on another private copy.
+    pybind11::list sequence;
+    BattleContext sequenceState(*searcher.rootState);
+    for (const auto &action : searcher.bestActionSequence) {
+        if (!action.isValidAction(sequenceState)) {
+            break;
+        }
+        pybind11::dict d;
+        d["action"] = action;
+        d["bits"] = action.bits;
+        d["description"] = describeBattleAction(sequenceState, action, includeCardType);
+        d["turn"] = sequenceState.turn;
+        sequence.append(d);
+        action.execute(sequenceState);
+    }
+    result["best_sequence"] = sequence;
+
+    pybind11::dict provenance;
+    provenance["searcher"] = "BattleScumSearcher2";
+    provenance["evaluation"] = "BattleScumSearcher2::evaluateEndState";
+    provenance["search_seed"] = effectiveSearchSeed;
+    provenance["draw_order_perturbed"] = drawOrderPerturbed;
+    if (drawOrderPerturbed) {
+        provenance["draw_order_seed"] = effectiveDrawOrderSeed;
+    } else {
+        provenance["draw_order_seed"] = pybind11::none();
+    }
+    provenance["state_copied"] = true;
+    provenance["live_state_mutated"] = false;
+    provenance["teacher_uses_full_simulator_state"] = true;
+    provenance["student_safe_observation"] = false;
+    provenance["floor"] = bc.floorNum;
+    provenance["turn"] = bc.turn;
+    provenance["encounter"] = std::string(
+        monsterEncounterStrings[static_cast<int>(bc.encounter)]);
+    provenance["exploration_parameter"] = searcher.explorationParameter;
+    result["provenance"] = provenance;
+    return result;
+}
