+pybind11::dict publicCardDict(const CardInstance &card, bool includeCardType=false) {
+    pybind11::dict d;
+    d["name"] = publicCardName(card);
+    d["label"] = publicCardLabel(card, includeCardType);
+    if (includeCardType) {
+        d["type"] = titleCase(cardTypeStrings[static_cast<int>(card.getType())]);
+    }
+    d["upgrade_count"] = card.getUpgradeCount();
+    d["cost"] = static_cast<int>(card.cost);
+    d["cost_for_turn"] = static_cast<int>(card.costForTurn);
+    d["free_to_play_once"] = card.freeToPlayOnce;
+    d["retain"] = card.retain;
+    return d;
+}
+
+pybind11::list publicCardGroupList(const CardGroups &groups, bool includeCardType=false) {
+    pybind11::list out;
+    for (const auto &entry : groups) {
+        auto d = publicCardDict(entry.second.first, includeCardType);
+        d["count"] = entry.second.second;
+        out.append(d);
+    }
+    return out;
+}
