+std::string energyCostLabel(int cost) {
+    if (cost == -1) {
+        return "X";
+    }
+    if (cost < -1) {
+        return "unplayable";
+    }
+    return std::to_string(cost);
+}
+
+// The pile label includes every card attribute that can affect an immediate
+// choice.  Pile output is later aggregated and sorted by this string, so the
+// underlying draw vector's order (which is hidden information) never leaks.
+std::string publicCardLabel(const CardInstance &card, bool includeCardType=false) {
+    std::ostringstream os;
+    os << publicCardName(card);
+    if (includeCardType) {
+        os << publicCardTypeTag(card);
+    }
+    os << " (cost " << energyCostLabel(card.costForTurn);
+    if (card.costForTurn != card.cost) {
+        os << ", base " << energyCostLabel(card.cost);
+    }
+    if (card.freeToPlayOnce) {
+        os << ", free once";
+    }
+    if (card.retain) {
+        os << ", retained";
+    }
+    os << ")";
+    return os.str();
+}
