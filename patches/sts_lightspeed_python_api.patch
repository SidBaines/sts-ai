+pybind11::dict publicPotions(const BattleContext &bc) {
+    pybind11::dict result;
+    result["capacity"] = bc.potionCapacity;
+    result["occupied"] = bc.potionCount;
+    pybind11::list slots;
+    for (int i = 0; i < bc.potionCapacity; ++i) {
+        pybind11::dict slot;
+        slot["index"] = i;
+        const auto potion = bc.potions[i];
+        const bool empty = potion == Potion::EMPTY_POTION_SLOT;
+        slot["empty"] = empty;
+        if (empty) {
+            slot["name"] = pybind11::none();
+        } else {
+            slot["name"] = std::string(safePotionName(potion));
+        }
+        slots.append(slot);
+    }
+    result["slots"] = slots;
+    return result;
+}
