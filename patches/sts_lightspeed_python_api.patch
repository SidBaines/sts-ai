+// Return the live combat value for relic counters that migrate from
+// RelicInstance::data into Player at battle entry.  Other relics retain their
+// copied entry data; ownership always comes from BattleContext::publicRelics,
+// never from the optimized active-relic bitsets.
+bool liveRelicCounter(const BattleContext &bc, RelicId id, int &value) {
+    switch (id) {
+        case RelicId::HAPPY_FLOWER: value = bc.player.happyFlowerCounter; return true;
+        case RelicId::INCENSE_BURNER: value = bc.player.incenseBurnerCounter; return true;
+        case RelicId::INK_BOTTLE: value = bc.player.inkBottleCounter; return true;
+        case RelicId::INSERTER: value = bc.player.inserterCounter; return true;
+        case RelicId::NUNCHAKU: value = bc.player.nunchakuCounter; return true;
+        case RelicId::PEN_NIB:
+            value = bc.player.penNibCounter == -1 ? 9 : bc.player.penNibCounter;
+            return true;
+        case RelicId::SUNDIAL: value = bc.player.sundialCounter; return true;
+        case RelicId::LIZARD_TAIL:
+            value = bc.player.hasRelicRuntime(RelicId::LIZARD_TAIL) ? 1 : 0;
+            return true;
+        default: return false;
+    }
+}
+
+pybind11::list publicRelics(const BattleContext &bc) {
+    pybind11::list out;
+    for (const auto &relic : bc.publicRelics) {
+        pybind11::dict d;
+        d["name"] = std::string(getRelicName(relic.id));
+        int counter = relic.data;
+        const bool live = liveRelicCounter(bc, relic.id, counter);
+        d["counter"] = counter;
+        d["counter_is_live"] = live;
+        out.append(d);
+    }
+    return out;
+}
+
+void appendPublicRelics(std::ostringstream &os, const BattleContext &bc) {
+    os << "\nRelics: ";
+    if (bc.publicRelics.empty()) {
+        os << "none";
+        return;
+    }
+    bool first = true;
+    for (const auto &relic : bc.publicRelics) {
+        if (!first) {
+            os << ", ";
+        }
+        os << getRelicName(relic.id);
+        int counter = relic.data;
+        const bool live = liveRelicCounter(bc, relic.id, counter);
+        if (live || relic.data != 0) {
+            os << " [counter " << counter << (live ? ", live" : "") << "]";
+        }
+        first = false;
+    }
+}
