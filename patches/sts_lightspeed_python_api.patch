+// Title-case an UPPER_SNAKE-free enum string ("ATTACK" -> "Attack") for the
+// out-of-combat card type/rarity tag. Avoids <cctype>/locale.
+std::string titleCase(const char *s) {
+    std::string out;
+    bool first = true;
+    for (const char *p = s; *p != '\0'; ++p) {
+        char ch = *p;
+        if (first) {
+            if (ch >= 'a' && ch <= 'z') ch = static_cast<char>(ch - 32);
+            first = false;
+        } else if (ch >= 'A' && ch <= 'Z') {
+            ch = static_cast<char>(ch + 32);
+        }
+        out += ch;
+    }
+    return out;
+}
+
+// " [Attack, Uncommon]" for an out-of-combat Card (reward/shop/card-select). The
+// simulator has no card *text*, but type+rarity are cheap static facts that help
+// the model weigh a draft. Uses the engine's CardType/CardRarity string tables.
+std::string cardTypeRarityTag(const Card &card) {
+    std::ostringstream os;
+    os << " [" << titleCase(cardTypeStrings[static_cast<int>(card.getType())])
+       << ", " << titleCase(cardRarityStrings[static_cast<int>(card.getRarity())]) << "]";
+    return os.str();
+}
+
+// A CardInstance::getName() deliberately returns only the base name.  Use one
+// canonical public label everywhere the model sees an in-combat card so upgraded
+// copies can never be confused with their base version.  specialData is public on
+// the few cards whose displayed damage/block grows during a run or combat.
+std::string publicCardName(const CardInstance &card) {
+    std::ostringstream os;
+    os << card.getName();
+    if (card.getId() == CardId::RITUAL_DAGGER || card.getId() == CardId::RAMPAGE
+            || card.getId() == CardId::GENETIC_ALGORITHM) {
+        os << "=" << card.specialData;
+    }
+    const int upgradeCount = card.getUpgradeCount();
+    if (upgradeCount > 0) {
+        os << "+";
+        if (card.getId() == CardId::SEARING_BLOW) {
+            os << upgradeCount;
+        }
+    }
+    return os.str();
+}
