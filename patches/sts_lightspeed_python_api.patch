+using CardGroups = std::map<std::string, std::pair<CardInstance, int>>;
+
+template <typename ForwardIt>
+CardGroups aggregatePublicCards(ForwardIt begin, ForwardIt end, bool includeCardType=false) {
+    CardGroups groups;
+    for (auto it = begin; it != end; ++it) {
+        const auto label = publicCardLabel(*it, includeCardType);
+        const auto found = groups.find(label);
+        if (found == groups.end()) {
+            groups.emplace(label, std::make_pair(*it, 1));
+        } else {
+            ++found->second.second;
+        }
+    }
+    return groups;
+}
+
+void appendPublicPile(std::ostringstream &os, const char *name, const CardGroups &groups) {
+    os << "\n" << name << " contents (unordered): ";
+    if (groups.empty()) {
+        os << "none";
+        return;
+    }
+    bool first = true;
+    for (const auto &entry : groups) {
+        if (!first) {
+            os << ", ";
+        }
+        os << entry.first;
+        if (entry.second.second > 1) {
+            os << " x" << entry.second.second;
+        }
+        first = false;
+    }
+}
