+const char *publicStanceName(Stance stance) {
+    // The upstream stanceStrings table has CALM/WRATH in enum-incompatible
+    // order. Keep the policy-facing value explicit and correct.
+    switch (stance) {
+        case Stance::NEUTRAL: return "NEUTRAL";
+        case Stance::CALM: return "CALM";
+        case Stance::WRATH: return "WRATH";
+        case Stance::DIVINITY: return "DIVINITY";
+        default: return "UNKNOWN";
+    }
+}
