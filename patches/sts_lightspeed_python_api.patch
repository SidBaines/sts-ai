+// Number of times an attack hits the annotated enemy. The engine encodes this
+// inline in BattleContext::useAttackCard (no table), so we mirror it here — the static
+// twin of Cards::getBaseDamage. The static table defaults to 1; the context overload
+// below handles Whirlwind and Fiend Fire. Ironclad-scoped; keep in sync with the card
+// pool. With multiple enemies, Sword Boomerang's count is shared across random
+// targets, so its per-target annotation reports only the damage per hit.
+int getHitCount(CardId id, bool upgraded) {
+    switch (id) {
+        case CardId::TWIN_STRIKE:     return 2;
+        case CardId::PUMMEL:          return upgraded ? 5 : 4;
+        case CardId::SWORD_BOOMERANG: return upgraded ? 4 : 3;
+        default:                      return 1;
+    }
+}
+
+int getHitCount(const BattleContext &bc, const CardInstance &card) {
+    switch (card.getId()) {
+        case CardId::WHIRLWIND:
+            // Action::execute queues current energy; WhirlwindAction adds
+            // Chemical X even when the card is free to play once.
+            return bc.player.energy + (bc.player.hasRelic<RelicId::CHEMICAL_X>() ? 2 : 0);
+        case CardId::FIEND_FIRE:
+            // The played card leaves the hand before FiendFireAction counts it.
+            return bc.cards.cardsInHand - 1;
+        default:
+            return getHitCount(card.getId(), card.isUpgraded());
+    }
+}
+
+// Attacks whose real base is not the static getBaseDamage table: they apply a
+// card-specific formula inline in useAttackCard (block-based, strength-scaled, growing,
+// or hand-size-based). Ironclad-scoped; keep in sync with the card pool.
+bool hasSpecialDamageFormula(CardId id) {
+    switch (id) {
+        case CardId::BODY_SLAM:        // damage = current block
+        case CardId::HEAVY_BLADE:      // strength counts 3x (5x upgraded)
+        case CardId::PERFECTED_STRIKE: // + per Strike-named card in deck
+        case CardId::RAMPAGE:          // grows each play (specialData)
+        case CardId::SEARING_BLOW:     // scales with times upgraded
+        case CardId::FIEND_FIRE:       // damage per card in hand
+            return true;
+        default:
+            return false;
+    }
+}
+
+// Base damage for the targeted special-formula cards that the computed-damage
+// opt-in supports. These expressions deliberately mirror BattleContext::useAttackCard
+// before passing through calculateCardDamage, including Heavy Blade's additional
+// Strength applications. Fiend Fire's base is per hit; its hand-dependent hit
+// count is handled by the context overload of getHitCount.
+int getSpecialDamageBase(const BattleContext &bc, const CardInstance &card) {
+    const bool upgraded = card.isUpgraded();
+    switch (card.getId()) {
+        case CardId::FIEND_FIRE:
+            return upgraded ? 10 : 7;
+        case CardId::BODY_SLAM:
+            return bc.player.block;
+        case CardId::HEAVY_BLADE:
+            return 14 + (upgraded ? 4 : 2) * bc.player.getStatus<PS::STRENGTH>();
+        case CardId::PERFECTED_STRIKE:
+            return 6 + bc.cards.strikeCount * (upgraded ? 3 : 2);
+        case CardId::RAMPAGE:
+            return 8 + card.specialData;
+        case CardId::SEARING_BLOW: {
+            const int n = card.getUpgradeCount();
+            return n * (n + 7) / 2 + 12;
+        }
+        default:
+            return -1;
+    }
+}
+
+// Base damage for every untargeted ATTACK implemented by the Ironclad
+// BattleContext::useAttackCard path. The engine folds Vigor into the queued base,
+// then removes the status before the queued action calculates damage. An annotation
+// is computed before card use, so calculateCardDamage sees the live Vigor and these
+// bases must exclude it to match the engine's single application.
+int getUntargetedDamageBase(const CardInstance &card) {
+    const bool upgraded = card.isUpgraded();
+    switch (card.getId()) {
+        case CardId::CLEAVE:             return upgraded ? 11 : 8;
+        case CardId::DRAMATIC_ENTRANCE:  return upgraded ? 12 : 8;
+        case CardId::IMMOLATE:           return upgraded ? 28 : 21;
+        case CardId::REAPER:             return upgraded ? 5 : 4;
+        case CardId::SWORD_BOOMERANG:    return 3;
+        case CardId::THUNDERCLAP:        return upgraded ? 7 : 4;
+        case CardId::WHIRLWIND:          return upgraded ? 8 : 5;
+        default:                         return -1;
+    }
+}
