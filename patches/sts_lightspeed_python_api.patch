+pybind11::dict publicEvent(const GameContext &gc) {
+    pybind11::dict d;
+    if (gc.screenState != ScreenState::EVENT_SCREEN) { return d; }
+    d["event"] = publicEventNames[static_cast<int>(gc.curEvent)];
+    switch (gc.curEvent) {
+        case Event::CURSED_TOME: case Event::SCRAP_OOZE: case Event::MATCH_AND_KEEP:
+            d["event_data"] = gc.info.eventData; break;
+        case Event::DEAD_ADVENTURER: d["phase"] = gc.info.phase; break;
+        case Event::DESIGNER_IN_SPIRE:
+            d["upgrade_one"] = gc.info.upgradeOne;
+            d["cleanup_is_remove"] = gc.info.cleanUpIsRemoveCard; break;
+        case Event::BIG_FISH: case Event::FACE_TRADER: case Event::FORGOTTEN_ALTAR:
+        case Event::GHOSTS: case Event::SHINING_LIGHT: case Event::THE_CLERIC:
+        case Event::THE_LIBRARY: case Event::THE_MOAI_HEAD: case Event::THE_WOMAN_IN_BLUE:
+        case Event::VAMPIRES:
+            d["hp_amount0"] = gc.info.hpAmount0; break;
+        case Event::GOLDEN_IDOL:
+            d["hp_amount0"] = gc.info.hpAmount0; d["hp_amount1"] = gc.info.hpAmount1; break;
+        case Event::KNOWING_SKULL: case Event::WINDING_HALLS:
+            d["hp_amount0"] = gc.info.hpAmount0; d["hp_amount1"] = gc.info.hpAmount1;
+            d["hp_amount2"] = gc.info.hpAmount2; break;
+        case Event::WORLD_OF_GOOP: d["gold_loss"] = gc.info.goldLoss; break;
+        case Event::FALLING: {
+            auto addCard = [&](const char *key, int idx) {
+                if (idx >= 0 && idx < gc.deck.size()) { std::ostringstream os; os << gc.deck.cards[idx]; d[key] = os.str(); }
+            };
+            addCard("falling_skill_card", gc.info.skillCardDeckIdx);
+            addCard("falling_power_card", gc.info.powerCardDeckIdx);
+            addCard("falling_attack_card", gc.info.attackCardDeckIdx); break;
+        }
+        case Event::NLOTH:
+            d["relic0"] = std::string(getRelicName(gc.relics.relics[gc.info.relicIdx0].id));
+            d["relic1"] = std::string(getRelicName(gc.relics.relics[gc.info.relicIdx1].id)); break;
+        case Event::WE_MEET_AGAIN:
+            d["gold"] = gc.info.gold;
+            if (gc.info.potionIdx >= 0 && gc.info.potionIdx < gc.potionCapacity) {
+                d["potion"] = std::string(safePotionName(gc.potions[gc.info.potionIdx]));
+            }
+            if (gc.info.cardIdx >= 0 && gc.info.cardIdx < gc.deck.size()) {
+                std::ostringstream os; os << gc.deck.cards[gc.info.cardIdx]; d["card"] = os.str();
+            }
+            break;
+        default: break;
+    }
+    return d;
+}
