+// Card type is displayed on every in-combat card in combat_public_v2.  It is a
+// basic human-visible property (colour/icon in the game UI), and is strategically
+// essential for triggers such as Gremlin Nob's Enrage and Corruption.  Keep it
+// separate from the out-of-combat type+rarity tag so v1 remains byte-compatible.
+std::string publicCardTypeTag(const CardInstance &card) {
+    std::ostringstream os;
+    os << " [" << titleCase(cardTypeStrings[static_cast<int>(card.getType())]) << "]";
+    return os.str();
+}
