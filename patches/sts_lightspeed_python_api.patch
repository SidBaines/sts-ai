+std::string describeGameAction(const GameContext &gc, const search::GameAction &a) {
+    // NOTE: the raw action `bits` are intentionally omitted from this human-/model-
+    // facing description; they remain available structurally on LegalAction.bits.
+    std::ostringstream os;
+
+    if (a.isPotionAction()) {
+        const int slot = a.getIdx1();
+        if (slot >= gc.potionCapacity) {
+            throw std::runtime_error("potion slot out of range");
+        }
+        const auto potion = gc.potions[slot];
+        os << (a.isPotionDiscard() ? "discard potion " : "drink potion ")
+           << safePotionName(potion) << " (slot " << slot << ")";
+        if (!a.isPotionDiscard()) {
+            switch (potion) {
+                case Potion::BLOOD_POTION:
+                    os << ": heal "
+                       << gc.fractionMaxHp(gc.hasRelic(RelicId::SACRED_BARK) ? 0.40f : 0.20f)
+                       << " HP";
+                    break;
+                case Potion::FRUIT_JUICE: {
+                    const int amount = gc.hasRelic(RelicId::SACRED_BARK) ? 10 : 5;
+                    os << ": gain " << amount << " max HP and heal " << amount << " HP";
+                    break;
+                }
+                case Potion::ENTROPIC_BREW:
+                    os << ": fill empty potion slots with random potions";
+                    break;
+                default:
+                    break;
+            }
+        }
+        return os.str();
+    }
+
+    switch (gc.screenState) {
+        case ScreenState::EVENT_SCREEN: {
+            os << "event option " << a.getIdx1();
+            if (gc.curEvent == Event::NEOW && a.getIdx1() >= 0 && a.getIdx1() < 4) {
+                const auto &r = gc.info.neowRewards[a.getIdx1()];
+                os << ": " << Neow::bonusStrings[static_cast<int>(r.r)];
+                const auto drawback = Neow::drawbackStrings[static_cast<int>(r.d)];
+                if (a.getIdx1() > 0 && drawback[0] != '\0') {
+                    os << " / " << drawback;
+                }
+            }
+            break;
+        }
+
+        case ScreenState::REWARDS: {
+            const auto &r = gc.info.rewardsContainer;
+            switch (a.getRewardsActionType()) {
+                case search::GameAction::RewardsActionType::GOLD:
+                    os << "take gold";
+                    if (a.getIdx1() >= 0 && a.getIdx1() < r.goldRewardCount) {
+                        os << " " << r.gold[a.getIdx1()] << "g";
+                    }
+                    break;
+                case search::GameAction::RewardsActionType::CARD:
+                    if (a.getIdx1() >= 0 && a.getIdx1() < r.cardRewardCount
+                        && a.getIdx2() >= 0 && a.getIdx2() < r.cardRewards[a.getIdx1()].size()) {
+                        const auto &card = r.cardRewards[a.getIdx1()][a.getIdx2()];
+                        os << "take card " << card << cardTypeRarityTag(card);
+                    } else if (a.getIdx2() == 5) {
+                        if (gc.hasRelic(RelicId::SINGING_BOWL)) {
+                            os << "gain +2 max hp (Singing Bowl); lose card reward";
+                        } else {
+                            os << "skip card reward";
+                        }
+                    } else {
+                        os << "card reward choice";
+                    }
+                    break;
+                case search::GameAction::RewardsActionType::RELIC:
+                    os << "take relic";
+                    if (a.getIdx1() >= 0 && a.getIdx1() < r.relicCount) {
+                        os << " " << getRelicName(r.relics[a.getIdx1()]);
+                    }
+                    break;
+                case search::GameAction::RewardsActionType::POTION:
+                    os << "take potion";
+                    if (a.getIdx1() >= 0 && a.getIdx1() < r.potionCount) {
+                        os << " " << safePotionName(r.potions[a.getIdx1()]);
+                    }
+                    break;
+                case search::GameAction::RewardsActionType::KEY:
+                    os << "take key";
+                    break;
+                case search::GameAction::RewardsActionType::CARD_REMOVE:
+                    os << "card remove";
+                    break;
+                case search::GameAction::RewardsActionType::SKIP:
+                    os << "skip rewards / proceed";
+                    break;
+            }
+            break;
+        }
+
+        case ScreenState::BOSS_RELIC_REWARDS:
+            if (a.getIdx1() >= 0 && a.getIdx1() < 3) {
+                os << "take boss relic " << getRelicName(gc.info.bossRelics[a.getIdx1()]);
+            } else {
+                os << "skip boss relic reward";
+            }
+            break;
+
+        case ScreenState::CARD_SELECT:
+            os << "select card index " << a.getIdx1();
+            if (a.getIdx1() >= 0 && a.getIdx1() < gc.info.toSelectCards.size()) {
+                const auto &card = gc.info.toSelectCards[a.getIdx1()].card;
+                os << ": " << card << cardTypeRarityTag(card);
+            }
+            break;
+
+        case ScreenState::MAP_SCREEN:
+            os << "choose map node x=" << a.getIdx1();
+            if (gc.map != nullptr) {
+                if (gc.curMapNodeY == -1) {
+                    const auto &node = gc.map->getNode(a.getIdx1(), 0);
+                    os << " room=" << roomStrings[static_cast<int>(node.room)];
+                } else if (gc.curMapNodeY == 14) {
+                    os << " advance to boss";
+                } else {
+                    const auto &node = gc.map->getNode(a.getIdx1(), gc.curMapNodeY + 1);
+                    os << " room=" << roomStrings[static_cast<int>(node.room)];
+                }
+                if (gc.curMapNodeY < 14 && a.getIdx1() == gc.map->burningEliteX
+                    && gc.curMapNodeY + 1 == gc.map->burningEliteY) {
+                    os << " (burning: Emerald Key)";
+                }
+            }
+            break;
+
+        case ScreenState::TREASURE_ROOM:
+            os << (a.getIdx1() == 0 ? "open chest" : "skip chest");
+            break;
+
+        case ScreenState::REST_ROOM:
+            // Bare campfire labels (rest/smith/...) were misread by the LLM (e.g.
+            // it believed "smith" fetched a relic). Spell out each option's effect.
+            switch (a.getIdx1()) {
+                case 0: os << "rest (heal 30% of max HP)"; break;
+                case 1: os << "smith (upgrade a card in your deck)"; break;
+                case 2: os << "recall (obtain the Ruby Key)"; break;
+                case 3: os << "lift (Girya: gain 1 permanent Strength)"; break;
+                case 4: os << "toke (Peace Pipe: remove a card from your deck)"; break;
+                case 5: os << "dig (Shovel: obtain a random relic)"; break;
+                case 6: os << "skip campfire (proceed without resting)"; break;
+                default: os << "campfire option " << a.getIdx1(); break;
+            }
+            break;
+
+        case ScreenState::SHOP_ROOM: {
+            const auto &s = gc.info.shop;
+            switch (a.getRewardsActionType()) {
+                case search::GameAction::RewardsActionType::CARD:
+                    os << "buy card";
+                    if (a.getIdx1() >= 0 && a.getIdx1() < 7) {
+                        const auto &card = s.cards[a.getIdx1()];
+                        os << " " << card << cardTypeRarityTag(card) << " for " << s.cardPrice(a.getIdx1()) << "g";
+                    }
+                    break;
+                case search::GameAction::RewardsActionType::RELIC:
+                    os << "buy relic";
+                    if (a.getIdx1() >= 0 && a.getIdx1() < 3) {
+                        os << " " << getRelicName(s.relics[a.getIdx1()]) << " for " << s.relicPrice(a.getIdx1()) << "g";
+                    }
+                    break;
+                case search::GameAction::RewardsActionType::POTION:
+                    os << "buy potion";
+                    if (a.getIdx1() >= 0 && a.getIdx1() < 3) {
+                        os << " " << safePotionName(s.potions[a.getIdx1()]) << " for " << s.potionPrice(a.getIdx1()) << "g";
+                    }
+                    break;
+                case search::GameAction::RewardsActionType::CARD_REMOVE:
+                    os << "buy card remove for " << s.removeCost << "g";
+                    break;
+                case search::GameAction::RewardsActionType::SKIP:
+                    os << "leave shop";
+                    break;
+                default:
+                    os << "shop action";
+                    break;
+            }
+            break;
+        }
+
+        case ScreenState::BATTLE:
+            os << "battle action unavailable through GameAction";
+            break;
+
+        case ScreenState::INVALID:
+        default:
+            os << "invalid/no-op";
+            break;
+    }
+
+    return os.str();
+}
+
+// Human-/model-facing reason the out-of-combat CARD_SELECT screen is open, so the
+// choice is judgeable: the bare "Card select: 0/1" never said whether the picked
+// card is removed, upgraded, transformed, etc. Mirrors CardSelectScreenType.
+const char *cardSelectPurpose(CardSelectScreenType type) {
+    switch (type) {
+        case CardSelectScreenType::TRANSFORM:
+            return "Choose a card to TRANSFORM (replace it with a random different card)";
+        case CardSelectScreenType::TRANSFORM_UPGRADE:
+            return "Choose a card to TRANSFORM and then UPGRADE";
+        case CardSelectScreenType::UPGRADE:
+            return "Choose a card to UPGRADE";
+        case CardSelectScreenType::REMOVE:
+            return "Choose a card to REMOVE from your deck";
+        case CardSelectScreenType::DUPLICATE:
+            return "Choose a card to DUPLICATE (add another copy to your deck)";
+        case CardSelectScreenType::OBTAIN:
+            return "Choose a card to OBTAIN (add it to your deck)";
+        case CardSelectScreenType::BOTTLE:
+            return "Choose a card to BOTTLE (it will start every combat already in your hand)";
+        case CardSelectScreenType::BONFIRE_SPIRITS:
+            return "Choose a card to SACRIFICE in the Bonfire (it is removed from your deck)";
+        default:
+            return "Choose a card";
+    }
+}
