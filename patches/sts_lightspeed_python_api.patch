+pybind11::dict publicCards(const BattleContext &bc, bool includeCardType=false) {
+    pybind11::dict result;
+    result["order_semantics"] = "hand is indexed; draw/discard/exhaust are unordered aggregates";
+    result["turn"] = bc.turn;
+    result["cards_played_this_turn"] = bc.player.cardsPlayedThisTurn;
+    result["attacks_played_this_turn"] = bc.player.attacksPlayedThisTurn;
+    result["skills_played_this_turn"] = bc.player.skillsPlayedThisTurn;
+    result["cards_discarded_this_turn"] = bc.player.cardsDiscardedThisTurn;
+    result["energy"] = bc.player.energy;
+    result["energy_per_turn"] = static_cast<int>(bc.player.energyPerTurn);
+
+    pybind11::list hand;
+    for (int i = 0; i < bc.cards.cardsInHand; ++i) {
+        auto d = publicCardDict(bc.cards.hand[i], includeCardType);
+        d["index"] = i;
+        hand.append(d);
+    }
+    result["hand"] = hand;
+    result["draw"] = publicCardGroupList(
+        aggregatePublicCards(
+            bc.cards.drawPile.begin(), bc.cards.drawPile.end(), includeCardType),
+        includeCardType);
+    result["discard"] = publicCardGroupList(
+        aggregatePublicCards(
+            bc.cards.discardPile.begin(), bc.cards.discardPile.end(), includeCardType),
+        includeCardType);
+    result["exhaust"] = publicCardGroupList(
+        aggregatePublicCards(
+            bc.cards.exhaustPile.begin(), bc.cards.exhaustPile.end(), includeCardType),
+        includeCardType);
+    if (bc.inputState == InputState::CARD_SELECT) {
+        pybind11::dict selection;
+        selection["type"] = std::string(
+            cardSelectTaskStrings[static_cast<int>(bc.cardSelectInfo.cardSelectTask)]);
+        pybind11::list candidates;
+        for (const auto &action : enumerateBattleActions(bc, includeCardType)) {
+            candidates.append(describeBattleAction(bc, action, includeCardType));
+        }
+        selection["candidates"] = candidates;
+        result["selection"] = selection;
+    }
+    return result;
+}
