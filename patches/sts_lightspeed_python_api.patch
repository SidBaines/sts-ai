+std::vector<std::pair<std::string, int>> publicPlayerPowerEntries(const Player &player) {
+    std::vector<std::pair<std::string, int>> entries;
+    for (int idx = static_cast<int>(PlayerStatus::DOUBLE_DAMAGE);
+            idx < static_cast<int>(PlayerStatus::THE_BOMB); ++idx) {
+        const auto status = static_cast<PlayerStatus>(idx);
+        int amount = 0;
+        switch (status) {
+            case PlayerStatus::ARTIFACT: amount = player.artifact; break;
+            case PlayerStatus::DEXTERITY: amount = player.dexterity; break;
+            case PlayerStatus::FOCUS: amount = player.focus; break;
+            case PlayerStatus::STRENGTH: amount = player.strength; break;
+            default: {
+                if (!player.hasStatusRuntime(status)) {
+                    continue;
+                }
+                const auto found = player.statusMap.find(status);
+                // Corruption, Barricade, Confused, Pen Nib, and Surrounded are
+                // stored only as status bits. Their visible amount is boolean 1.
+                amount = found == player.statusMap.end() ? 1 : found->second;
+                break;
+            }
+        }
+        if (amount != 0) {
+            entries.emplace_back(playerStatusStrings[idx], amount);
+        }
+    }
+    // The Bomb bypasses both statusBits and statusMap; its three public countdown
+    // slots are the complete state needed to interpret the power.
+    if (player.bomb1 != 0) {
+        entries.emplace_back("The Bomb (1 turn)", player.bomb1);
+    }
+    if (player.bomb2 != 0) {
+        entries.emplace_back("The Bomb (2 turns)", player.bomb2);
+    }
+    if (player.bomb3 != 0) {
+        entries.emplace_back("The Bomb (3 turns)", player.bomb3);
+    }
+    return entries;
+}
